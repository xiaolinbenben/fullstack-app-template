POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=app
# 三个值只使用字母、数字和连字符。
# 应用容器用这三个值连接服务名 postgres 的容器端口 5432。
# 本机 make server-dev 和 make test 把主机名改成 127.0.0.1，端口仍是 5432。
ENCRYPTION_KEY=replace-with-a-long-random-key

# 下面两行默认不启用。Compose 未读到变量时，应用宿主机端口是 3000，数据库宿主机端口是 5432。
# 它们只改变宿主机回环地址上的映射，不改变容器内部端口。
# 应用容器不读取 POSTGRES_HOST_PORT，始终连接 postgres:5432。
# 服务器上端口被占用时，去掉对应行首的 #，改成空闲端口。
# 1Panel 反向代理指向 127.0.0.1 上的应用宿主机端口。
# 本机 make server-dev 从宿主机连接 127.0.0.1:5432，所以本机不要启用 POSTGRES_HOST_PORT。
# APP_HOST_PORT=3000
# POSTGRES_HOST_PORT=5432
